{
  "name": "eslint-plugin-acrocase",
  "version": "0.0.1",
  "description": "ESLint plugin to enforce ACROCase naming conventions",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "libuild build",
    "test": "libuild build && node test/acrocase.test.ts",
    "develop": "shovel develop website/app.tsx --platform bun",
    "static": "MODE=production shovel build website/app.tsx --platform bun --lifecycle",
    "predeploy": "npm run static",
    "deploy": "gh-pages -d dist/public --nojekyll --cname acrocase.org",
    "preview": "bun run static && bunx serve dist/public"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "acrocase",
    "naming-convention",
    "acronyms"
  ],
  "author": "Brian Kim",
  "license": "MIT",
  "peerDependencies": {
    "eslint": "^10.8.1"
  },
  "devDependencies": {
    "@b9g/crank": "^0.7.9",
    "@b9g/libuild": "^0.2.20",
    "@b9g/router": "^0.2.5",
    "@b9g/shovel": "^0.2.19",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bikeshaving/acrocase"
  }
}
