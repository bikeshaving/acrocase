{
  "name": "eslint-plugin-acrocase",
  "version": "0.0.1",
  "description": "A single ESLint rule, acrocase/acrocase, that keeps acronyms uppercase in identifiers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikeshaving/acrocase.git"
  },
  "homepage": "https://acrocase.org",
  "bugs": {
    "url": "https://github.com/bikeshaving/acrocase/issues"
  },
  "author": "Brian Kim",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.js": {
      "import": "./dist/index.js"
    },
    "./dictionary": {
      "types": "./dist/dictionary.d.ts",
      "import": "./dist/dictionary.js"
    },
    "./package.json": "./dist/package.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "scripts": {
    "test": "libuild test -p node",
    "build": "libuild build",
    "typecheck": "tsc --noEmit",
    "stage": "libuild stage --provenance",
    "prepublishOnly": "echo 'ERROR: Cannot publish from root directory. Use libuild publish instead.' && exit 1",
    "develop": "shovel develop website/app.tsx --platform bun",
    "static": "MODE=production shovel build website/app.tsx --platform bun --lifecycle",
    "predeploy": "npm run static",
    "deploy": "gh-pages -d dist/public --nojekyll --cname acrocase.org",
    "preview": "bun run static && bunx serve dist/public"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "acrocase",
    "naming-convention",
    "acronyms"
  ],
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@b9g/crank": "^0.7.9",
    "@b9g/libuild": "^0.2.21",
    "@b9g/router": "^0.2.5",
    "@b9g/shovel": "^0.2.19",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/types": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "eslint": "^10.8.1",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
